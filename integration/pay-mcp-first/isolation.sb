(version 1)
(allow default)
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(deny process-exec (literal "/usr/bin/security"))
(deny mach-lookup (global-name "com.apple.securityd"))
(deny file-read* file-write* (subpath "/Users/irin/Library/Keychains") (subpath "/Library/Keychains")
 (subpath "/Users/irin/.config/pay") (subpath "/Users/irin/.config/solana")
 (subpath "/Users/irin/Desktop/yosh") (subpath "/Users/irin/Desktop/open-source/pay")
 (subpath "/Users/irin/Library/Application Support/Yosh") (subpath "/Users/irin/Library/Application Support/2049"))
(deny file-write* (subpath "/Users/irin/Desktop/open-source/pay-external-authority-pr")
 (subpath "/Users/irin/Desktop/open-source/yosh-pay-integration-poc")
 (subpath "/Users/irin/.codex/worktrees/pay-production-integration") (subpath "/Users/irin/Applications/Yosh.app"))
