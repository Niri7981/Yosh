{
  "name": "yosh-local-backend",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "app:dev": "electron electron/main.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:pay": "python3 scripts/test-pay-integration.py --all",
    "test:watch": "vitest",
    "payment:preflight": "node scripts/run.mjs preflight",
    "e2e:evidence": "node scripts/run.mjs e2e-evidence",
    "localnet:start": "NO_DNA=1 solana-test-validator --ledger .data/solana-ledger --bind-address 127.0.0.1",
    "localnet:init": "bash scripts/localnet-init.sh",
    "payment:pay": "node scripts/run.mjs pay",
    "localnet:smoke": "node --import tsx scripts/localnet-smoke.ts",
    "wallet:setup": "node scripts/run.mjs wallet",
    "wallet:accounts": "node scripts/run.mjs accounts",
    "demo:dev": "node scripts/run.mjs server",
    "demo": "node scripts/run.mjs demo",
    "demo:preflight": "node scripts/run.mjs demo-preflight",
    "task:acceptance": "node scripts/run.mjs task-acceptance",
    "model:check": "node scripts/run.mjs model-check",
    "agent:run": "node scripts/run.mjs agent",
    "mcp": "node --import tsx scripts/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "@openai/agents": "^0.17.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
    "@x402/core": "^2.25.0",
    "@x402/svm": "^2.25.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "electron": "^44.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "yoshRelease": {
    "candidate": "0.1.1-rc.5",
    "buildNumber": "6"
  }
}
